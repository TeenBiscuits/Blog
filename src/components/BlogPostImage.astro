---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
	title: string
	pubId: string
	imageSrc: ImageMetadata
}

const { title, pubId, imageSrc } = Astro.props
---

<div
	class="dark:bg-primary-dark bg-primary relative overflow-hidden rounded-xl"
>
	<Picture
		src={imageSrc}
		alt={title}
		widths={[320, 480, 640, 750, 828, 1080, 1280, 1668, 1920]}
		sizes="(min-width: 768px) min(75ch, calc(100vw - 6rem)), calc(100vw - 3rem)"
		formats={['avif', 'webp']}
		fallbackFormat="jpg"
		priority
		class="relative w-full rounded-xl"
		layout="constrained"
		transition:name={`blog-cover-${pubId}`}
	/>
</div>
