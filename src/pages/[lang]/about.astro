---
import { LOCALES, useTranslations, type Lang } from '@/i18n'
const t = useTranslations(Astro.currentLocale as Lang)
import Layout from '@/layouts/Base.astro'
import { SocialLinks } from '@/consts'
import { Icon } from 'astro-icon/components'
import { getEntry, render } from 'astro:content'
import { Picture } from 'astro:assets'

export const getStaticPaths = () =>
	Object.keys(LOCALES).map((lang) => ({
		params: { lang },
	}))

import profilePicture from '/src/assets/about-me.jpg'
const currentLang = Astro.currentLocale as Lang
const aboutContent = await getEntry('about', currentLang)
if (!aboutContent) {
	return Astro.redirect('/404')
}
const { Content } = await render(aboutContent)
---

<Layout
	title={t({ es: 'Acerca de Mí', gl: 'Eu', en: 'About Me' })}
	description={t({
		es: 'Pablo Portas López, estudiante de Ingeniería Informática. Con ganas de entender el mundo. Este es mi blog personal.',
		gl: 'Pablo Portas López, estudante de Enxeñaría Informática. Con ganas de entender o mundo. Este é o meu blog persoal.',
		en: 'Pablo Portas López, Computer Engineering student. Eager to understand the world. This is my personal blog.',
	})}
	lastModified={aboutContent?.data.pubDate.toISOString()}
>
	<main>
		<article
			class="app-container relative grid gap-8 py-24 pt-36 lg:grid-cols-[minmax(0,3fr)_minmax(180px,1fr)]"
		>
			<h1
				class="pb-8 font-serif text-6xl font-bold lg:col-start-1 lg:row-start-1"
			>
				{t({ es: 'Acerca de Mí', gl: 'Eu', en: 'About Me' })}
			</h1>
			<div
				class="mb-8 lg:sticky lg:top-28 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mb-0 lg:max-w-[352px] lg:justify-self-end"
			>
				<Picture
					src={profilePicture}
					alt="About Me"
					widths={[320, 352, 640, 704, 750]}
					sizes="(min-width: 1024px) min(25vw, 352px), calc(100vw - 3rem)"
					formats={['avif', 'webp']}
					fallbackFormat="jpg"
					loading="lazy"
					class="relative w-full rounded-lg object-cover"
					layout="constrained"
				/>
				<p class="mt-2 mb-4 text-sm italic opacity-80">
					{
						t({
							es: 'Este joven apuesto soy yo',
							gl: 'Este mozo guapo son eu',
							en: 'This handsome young man is me',
						})
					}
				</p>
				{
					SocialLinks.map((link) => (
						<a
							class="text-primary dark:text-primary-dark hover:animate-pulse"
							href={link.url}
							aria-label={link.name}
							data-umami-event="Social About Link"
							data-umami-event-url={link.url}
							rel="nofollow noopener noreferrer me"
							target="_blank"
						>
							<Icon
								size={35}
								name={`mdi:${link.icon}`}
								class="mr-2 mb-1 inline-block"
							/>
						</a>
					))
				}
			</div>
			<div class="w-full md:max-w-[75ch] lg:col-start-1 lg:row-start-2">
				<div
					class="prose prose-neutral prose-lg md:prose-xl dark:prose-invert prose-img:rounded-xl prose-figure:text-center prose-img:mx-auto"
				>
					<Content />
				</div>
			</div>
		</article>
	</main>
</Layout>
